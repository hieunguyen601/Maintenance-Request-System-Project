PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=maintenance_services
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_ORIGIN=http://localhost:5173
# Optional: use the same Google client ID in frontend/.env.
GOOGLE_CLIENT_ID=

# Neon/Render: use DATABASE_URL instead of DB_HOST/DB_USER/etc.
# Copy the connection URL from Neon; preserve its TLS and channel-binding parameters.
# DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Optional direct connection for database setup and manager creation.
# DIRECT_DATABASE_URL=postgresql://user:password@your-endpoint.region.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Render terminates HTTPS at its proxy. Set this only behind that proxy.
TRUST_PROXY=0
# Root npm start sets this to true for the combined local production server.
SERVE_FRONTEND=false
