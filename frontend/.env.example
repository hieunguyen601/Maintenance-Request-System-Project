# Development: leave unset to use the Vite /api proxy.
# Vercel: set this to the Render backend URL, including /api, then redeploy.
# Vercel builds fail with a clear message if this is missing or invalid.
# VITE_API_BASE_URL=https://your-service.onrender.com/api
# Optional: same OAuth client ID as GOOGLE_CLIENT_ID on Render.
VITE_GOOGLE_CLIENT_ID=
